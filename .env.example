# SmartFit backend environment.
# Copy to .env (gitignored) and fill in. Read by docker compose and by the
# backend when run directly (backend/shared/config.py). NEVER commit .env.

# ── Supabase (Dashboard -> Project Settings -> API) ──────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Optional, legacy projects only (Settings -> API -> JWT secret). Lets the
# gateway verify tokens locally instead of asking Supabase.
SUPABASE_JWT_SECRET=
# Service-role key (Settings -> API). BACKEND ONLY: Storage uploads, product
# catalog and scoring-config writes. Never put it in the Flutter app.
SUPABASE_SERVICE_KEY=

# ── AI stylist (Google AI Studio -> API keys) ────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ── Models ───────────────────────────────────────────────────────────────
# Hugging Face read token (huggingface.co/settings/tokens) for gated downloads.
HUGGINGFACE_TOKEN=

# ── Try-on (GPU) ─────────────────────────────────────────────────────────
# Chosen by the baseline comparison (docs/evaluation/tryon_model_selection.md).
TRYON_MODEL_NAME=idm-vton
TRYON_LORA_ADAPTER_PATH=
# The DressCode adapter (spec §23.20) was evaluated and accepted: true.
LORA_WEIGHTS_ENABLED=true
# Categories that use the adapter (upper,lower,dress); remove one to switch it off.
TRYON_LORA_CATEGORIES=upper,lower,dress
GPU_DEVICE=cuda:0
# Try-on jobs running at once (each uses up to 2 Modal GPU containers).
MAX_CONCURRENT_TRYON_JOBS=2
# Where try-on images are made (docs/tryon-setup.md):
#   modal = the GPU app (backend/services/tryon/modal_app.py, after `modal deploy`)
#   mock  = TEST MODE placeholders, clearly labelled in the app (no GPU needed)
#   empty = off (the app says the AI studio is offline)
TRYON_BACKEND=mock
# Hairstyle previews (spec §23.27): modal = HairFastGAN on the GPU app in
# backend/services/hairstyle/modal_app.py (realistic, replaces the user's own
# hair); empty = the quick 2D overlay only.
HAIRSTYLE_BACKEND=
# Starting a try-on uses paid GPU time: per user per minute.
RATE_LIMIT_TRYON_PER_MIN=4

# ── Scraper ──────────────────────────────────────────────────────────────
SCRAPER_USER_AGENT=SmartFitFYP/1.0 (academic project; contact: admin@smartfit.pk)
SCRAPER_RATE_LIMIT_SECONDS=2
# Products kept per retailer per catalog refresh.
CATALOG_MAX_PRODUCTS=300
# Where the stores are read from: local = this machine; modal = the cloud runner
# (backend/services/scraper/modal_app.py, deploy it first). Same polite rules either way.
SCRAPER_BACKEND=local
# Automatic refresh of every brand (0 = off). The schedule survives restarts.
CATALOG_REFRESH_HOURS=24

# ── Recommendation (FashionCLIP, CPU) ────────────────────────────────────
FASHIONCLIP_MODEL=hf-hub:Marqo/marqo-fashionCLIP
# Load the model and embed the catalog when the service starts.
FASHIONCLIP_AUTOLOAD=true
RECOMMEND_TOP_N=10
# Without SUPABASE_SERVICE_KEY the catalog is kept in a local snapshot:
# CATALOG_SNAPSHOT_PATH=backend/data/catalog.jsonl

# ── Learned ranking + self-learning (spec §23.25, §23.26) ────────────────
# LightGBM ranks, a Random Forest validates; false = the rule ranking only.
LEARNED_RANKING_ENABLED=true
# Every N hours the recommendation and scoring services check for new user
# feedback and retrain in a separate process when there is enough of it; a new
# model goes live only if it is at least as good on held-out real feedback.
# 0 = off (e.g. when a Kubernetes CronJob does it instead).
AUTO_RETRAIN_HOURS=24
AUTO_RETRAIN_MIN_FEEDBACK=50
AUTO_RETRAIN_MIN_LOOK_RATINGS=20
# Store what the ranker showed signed-in users (model inputs only) so their
# loves / "not for me" become training rows. Deleted after N days.
IMPRESSION_LOGGING_ENABLED=true
IMPRESSION_RETENTION_DAYS=180

# ── Gateway ──────────────────────────────────────────────────────────────
# true = every API call needs a logged-in user's token (production setting).
AUTH_REQUIRED=true
ADMIN_EMAILS=admin@smartfit.pk
CORS_ORIGINS=*
DEBUG=true

# Service URLs default to the docker compose service names — only set them
# when running services outside Docker, e.g. CV_ANALYSIS_URL=http://127.0.0.1:8001
